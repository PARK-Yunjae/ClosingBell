# ===========================================
# ClosingBell v3 환경 설정
# ===========================================
# 값을 변경하면 코드 수정 없이 바로 반영됩니다.
# 주석(#)된 항목은 기본값이 적용됩니다.

# -------------------------------------------
# 키움증권 REST API (필수)
# -------------------------------------------
KIWOOM_APPKEY=your_appkey_here
KIWOOM_SECRETKEY=your_secretkey_here
KIWOOM_BASE_URL=https://api.kiwoom.com

# -------------------------------------------
# 디스코드 알림 (필수)
# -------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# -------------------------------------------
# AI (Gemini) — 없으면 룰 기반 fallback
# -------------------------------------------
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# -------------------------------------------
# DART 전자공시 — 없으면 스킵
# -------------------------------------------
DART_API_KEY=your_dart_key_here

# -------------------------------------------
# 데이터 경로
# -------------------------------------------
DATA_DIR=C:/Coding/data

# -------------------------------------------
# 스케줄 시간 (HH:MM)
# -------------------------------------------
SCHEDULE_SCREEN=14:55
SCHEDULE_UPDATE_DATA=15:35
SCHEDULE_GIT_PUSH=15:40
SCHEDULE_SHUTDOWN=15:43

# -------------------------------------------
# 추천 종목 수
# -------------------------------------------
TOP_N=3
TOP_N_CONSERVATIVE=2

# -------------------------------------------
# 가격 필터
# -------------------------------------------
MIN_PRICE=3000
MAX_PRICE=150000
MIN_CHANGE_RATE=1.0
MAX_CHANGE_RATE=29.0

# -------------------------------------------
# 나스닥 급락 대응
# -------------------------------------------
NASDAQ_DROP_THRESHOLD=-2.0
NASDAQ_PENALTY=5.0

# -------------------------------------------
# 점수 배점 (합계 100점)
# -------------------------------------------
SCORE_CCI=25
SCORE_MA20_GAP=20
SCORE_CHANGE=15
SCORE_CCI_SLOPE=10
SCORE_MA20_SLOPE=10
SCORE_RSI=5
SCORE_VOLUME_PROFILE=10
SCORE_BROKER_FLOW=5

# -------------------------------------------
# 점수 최적 구간 (종형분포)
# -------------------------------------------
# CCI: 이 구간이 만점, 벗어나면 감점
CCI_OPTIMAL_LOW=160
CCI_OPTIMAL_HIGH=180
CCI_ZERO_LOW=80
CCI_ZERO_HIGH=300

# MA20 이격도 (%): 이 구간이 만점
MA20_GAP_OPTIMAL_LOW=2.0
MA20_GAP_OPTIMAL_HIGH=8.0
MA20_GAP_ZERO=20.0

# 등락률 (%): 이 구간이 만점
CHANGE_OPTIMAL_LOW=2.0
CHANGE_OPTIMAL_HIGH=8.0
CHANGE_ZERO=20.0

# RSI: 이 구간이 만점
RSI_OPTIMAL_LOW=50
RSI_OPTIMAL_HIGH=70
RSI_ZERO_LOW=25
RSI_ZERO_HIGH=85

# -------------------------------------------
# 기술 설정
# -------------------------------------------
CCI_PERIOD=14
RSI_PERIOD=14
API_DELAY=0.12
