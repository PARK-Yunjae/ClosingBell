# ClosingBell v3.5 환경 설정
# 값을 변경하면 코드 수정 없이 바로 반영됩니다.

# 키움증권 REST API (필수)
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=
KIWOOM_BASE_URL=https://api.kiwoom.com

# 디스코드 알림 (필수)
DISCORD_WEBHOOK_URL=

# AI (Gemini) — 없으면 룰 기반 fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# DART 전자공시 — 없으면 스킵
DART_API_KEY=

# 네이버 뉴스 API — 없으면 키워드 판단
# 발급: https://developers.naver.com/apps/
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 데이터 경로
DATA_DIR=C:/Coding/data
